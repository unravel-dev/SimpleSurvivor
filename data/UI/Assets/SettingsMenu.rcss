/* ---------- Settings Menu Specific Styles ---------- */
/* All common styles are now inherited from CommonMenu.rcss */

/* ---------- Settings Content ---------- */
.settings-content {
  flex: 1;
  width: 100%;
  max-width: 600dp;
  margin-bottom: 32dp;
}

.settings-section {
  display: block;
  background-color: rgba(42, 58, 77, 77);
  border-radius: 12dp;
  padding: 24dp;
  margin-bottom: 24dp;
  border: 1dp rgba(58, 74, 93, 128);
  animation: fade-in-up 0.8s ease-out 0.2s both;
}

body.theme-light .settings-section {
  background-color: rgba(255, 255, 255, 204);
  border: 1dp rgba(203, 213, 224, 204);
}

.section-title {
  font-size: 24dp;
  font-weight: bold;
  color: #2a73ff;
  margin: 0 0 20dp 0;
  text-align: left;
}

body.theme-light .section-title {
  color: #3182ce;
}

/* ---------- Setting Items ---------- */
.setting-item {
  display: flex;
  flex-direction: column;
  gap: 12dp;
  margin-bottom: 20dp;
  text-align: left;
}

.setting-label {
  font-size: 16dp;
  font-weight: bold;
  color: #e9eef3;
  margin-bottom: 8dp;
}

body.theme-light .setting-label {
  color: #2d3748;
}

/* ---------- Slider Styling ---------- */
.slider-container {
  position: relative;
  width: 100%;
  height: 24dp;
  display: flex;
  align-items: center;
}

.volume-slider {
  width: 100%;
  height: 8dp;
  background-color: #2a3a4d;
  border-radius: 4dp;
  border: 0dp;
  cursor: pointer;
  position: relative;
}

/* Note: Slider thumb styling not supported in RmlUi - will use default styling */

body.theme-light .volume-slider {
  background-color: #cbd5e0;
}

/* ---------- Dropdown Styling ---------- */
.dropdown-container {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
}

.graphics-dropdown {
  width: 100%;
  height: auto;
  min-height: 44dp;
  background-color: #2a3a4d;
  color: #e9eef3;
  border: 2dp rgba(58, 74, 93, 128);
  border-radius: 8dp;
  font-size: 16dp;
  font-weight: bold;
  cursor: pointer;
}

.graphics-dropdown:hover {
  background-color: #3a4a5d;
  border: 2dp rgba(74, 90, 109, 128);
  transition: background-color border-color 0.2s cubic-in;
}

/* Override rml.rcss defaults for selectvalue (selected text display) */
.graphics-dropdown selectvalue {
  background-color: transparent;
  color: #e9eef3;
  padding: 12dp 16dp;
  border: 0dp;
}

/* Override rml.rcss defaults for selectarrow (dropdown trigger) */
.graphics-dropdown selectarrow {
  background-color: rgba(58, 74, 93, 128);
  border-left: 1dp rgba(58, 74, 93, 128);
  width: 32dp;
}
.graphics-dropdown selectarrow:hover,
.graphics-dropdown:focus-visible selectarrow {
  background-color: rgba(74, 90, 109, 128);
}
.graphics-dropdown selectarrow:active,
.graphics-dropdown selectarrow:checked {
  background-color: rgba(58, 74, 93, 180);
}

/* Override rml.rcss defaults for selectbox (dropdown list) */
.graphics-dropdown selectbox {
  margin-top: 2dp;
  padding: 4dp;
  background-color: #2a3a4d;
  border: 2dp rgba(58, 74, 93, 128);
  border-radius: 8dp;
}

/* Dropdown options - RmlUi places these inside selectbox */
.graphics-dropdown selectbox option {
  background-color: transparent;
  color: #e9eef3;
  padding: 10dp 12dp;
  font-size: 16dp;
  font-weight: normal;
  margin: 0;
  line-height: 1.4;
  border-top: 1dp rgba(58, 74, 93, 64);
}

.graphics-dropdown selectbox option:first-child {
  border-top: 0dp;
  border-radius: 6dp 6dp 0 0;
}

.graphics-dropdown selectbox option:last-child {
  border-radius: 0 0 6dp 6dp;
}

.graphics-dropdown selectbox option:only-child {
  border-radius: 6dp;
}

/* When dropdown is open */
.graphics-dropdown:focus,
.graphics-dropdown:checked {
  background-color: #3a4a5d;
}

.graphics-dropdown selectbox option:hover {
  background-color: #578df1;
  color: #ffffff;
}

.graphics-dropdown selectbox option:checked {
  background-color: #2a73ff;
  color: #ffffff;
  font-weight: bold;
}

body.theme-light .graphics-dropdown {
  background-color: #ffffff;
  color: #2d3748;
  border: 2dp rgba(203, 213, 224, 128);
}

body.theme-light .graphics-dropdown:hover {
  background-color: #f7fafc;
  border: 2dp rgba(160, 174, 192, 128);
}

body.theme-light .graphics-dropdown:focus,
body.theme-light .graphics-dropdown:checked {
  background-color: #f7fafc;
}

body.theme-light .graphics-dropdown selectvalue {
  background-color: transparent;
  color: #2d3748;
}

body.theme-light .graphics-dropdown selectarrow {
  background-color: rgba(203, 213, 224, 128);
  border-left-color: rgba(203, 213, 224, 128);
}
body.theme-light .graphics-dropdown selectarrow:hover,
body.theme-light .graphics-dropdown:focus-visible selectarrow {
  background-color: rgba(160, 174, 192, 128);
}

body.theme-light .graphics-dropdown selectbox {
  background-color: #ffffff;
  border-color: rgba(203, 213, 224, 128);
}

body.theme-light .graphics-dropdown selectbox option {
  background-color: transparent;
  color: #2d3748;
  border-top-color: rgba(203, 213, 224, 128);
}

body.theme-light .graphics-dropdown selectbox option:first-child {
  border-top: 0dp;
}

body.theme-light .graphics-dropdown selectbox option:hover {
  background-color: #3182ce;
  color: #ffffff;
}

body.theme-light .graphics-dropdown selectbox option:checked {
  background-color: #3182ce;
  color: #ffffff;
  font-weight: bold;
}

/* ---------- Placeholder Settings ---------- */
.setting-placeholder {
  padding: 12dp;
  background-color: rgba(42, 58, 77, 51);
  border-radius: 8dp;
  border: 1dp rgba(169, 187, 204, 77);
}

.placeholder-text {
  font-size: 14dp;
  color: #a9bbcc;
  font-style: italic;
  opacity: 0.7;
}

body.theme-light .setting-placeholder {
  background-color: rgba(247, 250, 252, 204);
  border: 1dp rgba(160, 174, 192, 128);
}

body.theme-light .placeholder-text {
  color: #4a5568;
}

/* ---------- Settings Navigation ---------- */
.settings-nav {
  margin-bottom: 24dp;
}

.settings-buttons {
  display: flex;
  flex-direction: row;
  gap: 16dp;
  justify-content: center;
  align-items: center;
}

/* ---------- Settings Section Entrance Animations ---------- */
.settings-section:nth-child(1) { 
  animation: fade-in-left 0.6s cubic-out 0.2s both; 
}
.settings-section:nth-child(2) { 
  animation: fade-in-left 0.6s cubic-out 0.4s both; 
}

/* Settings Button Entrance Animations (using unified menu-btn) */
.settings-buttons .menu-btn:nth-child(1) { 
  animation: fade-in-up 0.6s cubic-out 0.6s both; 
}
.settings-buttons .menu-btn:nth-child(2) { 
  animation: fade-in-up 0.6s cubic-out 0.8s both; 
}

/* ---------- Settings Accessibility ---------- */


/* ---------- Settings Responsive Design ---------- */
.settings-content {
  max-width: 90vw;
}

.settings-buttons {
  max-width: 100%;
  flex-wrap: wrap;
}