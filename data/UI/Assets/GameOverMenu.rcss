/* ---------- Game Over Menu Specific Styles ---------- */
/* All common styles are inherited from CommonMenu.rcss */

/* Game Over Menu Layout */
.gameover-menu-layout {
  display: flex;
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
}

/* Main menu content takes up full space */
.gameover-menu-layout .menu-container {
  flex: 1;
  position: relative;
}

