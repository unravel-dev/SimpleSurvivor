<rml>
  <head>
    <title>Game Hub</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss" />
    <link type="text/rcss" href="CommonMenu.rcss" />
    <link type="text/rcss" href="GameHub.rcss" />
  </head>

  <body id="body" class="theme-dark">
    <!-- Game Timer - Top Center -->
    <div class="timer-display">
      <span class="timer-label">TIME</span>
      <span id="game_timer" class="timer-value">00:00</span>
    </div>

    <!-- Boss Health Bars - Top of Screen -->
    <div id="boss_health_container" class="boss-health-container hidden"></div>

    <!-- Bottom HUD Container -->
    <div class="bottom-hud">
      <!-- Health Bar - Above Abilities -->
      <div class="health-bar-container">
        <progress id="health_bar" class="health-progress" value="1.0" max="1.0"></progress>
        <span id="health_value" class="health-value">100/100</span>
      </div>

      <!-- Ability Slots Bar -->
      <div class="ability-bar-container">
        <!-- Upgrade Counter -->
        <div id="upgrade_counter" class="upgrade-counter hidden">
          <span class="upgrade-counter-label">Upgrades:</span>
          <span id="upgrade_counter_value" class="upgrade-counter-value">0</span>
          <span class="upgrade-counter-label">Press (T)</span>

        </div>
        <div class="ability-bar">
          <!-- Ability slot 0 - Dash (larger) -->
          <div id="ability_slot_0" class="ability-slot ability-slot-dash">
            <div class="ability-icon" id="ability_icon_0"></div>
            <progress class="ability-cooldown" id="ability_cooldown_0" direction="top"></progress>
            <div class="ability-key">
              <span id="ability_key_0" class="ability-key-value">Space</span>
            </div>
          </div>
          
          <!-- Regular ability slots 1-4 -->
          <div id="ability_slot_1" class="ability-slot">
            <div class="ability-icon" id="ability_icon_1"></div>
            <progress class="ability-cooldown" id="ability_cooldown_1"></progress>
            <div class="ability-key">
              <span id="ability_key_1" class="ability-key-value">1</span>
            </div>
          </div>
          <div id="ability_slot_2" class="ability-slot">
            <div class="ability-icon" id="ability_icon_2"></div>
            <progress class="ability-cooldown" id="ability_cooldown_2"></progress>
            <div class="ability-key">
              <span id="ability_key_2" class="ability-key-value">2</span>
            </div>
          </div>
          <div id="ability_slot_3" class="ability-slot">
            <div class="ability-icon" id="ability_icon_3"></div>
            <progress class="ability-cooldown" id="ability_cooldown_3"></progress>
            <div class="ability-key">
              <span id="ability_key_3" class="ability-key-value">3</span>
            </div>
          </div>
          <div id="ability_slot_4" class="ability-slot">
            <div class="ability-icon" id="ability_icon_4"></div>
            <progress class="ability-cooldown" id="ability_cooldown_4"></progress>
            <div class="ability-key">
              <span id="ability_key_4" class="ability-key-value">4</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Experience Bar - Full Width Bottom -->
      <div class="xp-bar-bottom">
        <div class="level-display">
          <span id="level_value" class="level-text">1</span>
        </div>
        <progress id="experience_bar" class="xp-progress" value="0.3" max="1.0"></progress>
      </div>
    </div>

  </body>
</rml>
