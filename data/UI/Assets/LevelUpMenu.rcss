/* ---------- Level Up Menu Specific Styles ---------- */
/* Extends CommonMenu.rcss with card-specific styling */

/* ---------- Card Container ---------- */
.card-container {
  display: flex;
  flex-direction: row;
  gap: 24dp;
  justify-content: center;
  align-items: stretch;
  width: 100%;
  max-width: 900dp;
  margin: 0 auto;
}

/* ---------- Upgrade Cards ---------- */
.upgrade-card {
  display: flex;
  flex-direction: column;
  background-color: #1a2332;
  border: 2dp  #2a3a4d;
  border-radius: 12dp;
  padding: 20dp;
  width: 280dp;
  min-height: 320dp;
  cursor: pointer;
  transition: transform background-color border-color 0.3s cubic-out;
  position: relative;
  overflow: hidden;
}

.upgrade-card:hover {
  transform: translateY(-8dp) scale(1.02);
  border-color: #2a73ff;
  background-color: #1f2937;
}

.upgrade-card:active,
.upgrade-card.selected {
  transform: translateY(-4dp) scale(1.01);
  border-color: #1e5ce6;
  background-color: #2a73ff1a;
}

/* ---------- Card Header ---------- */
.card-header {
  margin-bottom: 16dp;
  text-align: center;
  border-bottom: 1dp #3a4a5d;
  padding-bottom: 12dp;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8dp;
}

/* ---------- Card Icon ---------- */
/* Base ability-icon styles - reusable for both ability slots and upgrade cards */
.ability-icon {
  width: 100%;
  height: 100%;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24dp;
  color: rgba(180, 180, 190, 255);
  font-weight: bold;
}

.ability-icon.has-ability {
  background-color: transparent;
  color: white;
}

.upgrade-card .ability-icon {
  width: 64dp;
  height: 64dp;
  margin-bottom: 4dp;
  border-radius: 8dp;
  background-color: rgba(40, 40, 45, 180);
  border: 2dp rgba(80, 80, 90, 120);
}

/* Ability icon styles for upgrade cards */
/* Note: Ability-specific styles (decorator, image, color) are now in CommonMenu.rcss */
/* Applied directly to .ability-icon.{abilityType} for reuse across slots and cards */

.card-title {
  font-size: 20dp;
  font-weight: bold;
  color: #2a73ff;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 1dp;
}

.card-rarity {
  font-size: 12dp;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.5dp;
  margin-top: 4dp;
  opacity: 0.8;
}

/* ---------- Card Body ---------- */
.card-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.card-description {
  font-size: 16dp;
  line-height: 1.5;
  color: #e9eef3;
  margin: 0;
  opacity: 0.9;
  white-space: pre-line;
}

/* ---------- Card Animations ---------- */
.upgrade-card:nth-child(1) {
  animation: 0.6s 0.2s cubic-out fade-in-up both;
}

.upgrade-card:nth-child(2) {
  animation: 0.6s 0.4s cubic-out fade-in-up both;
}

.upgrade-card:nth-child(3) {
  animation: 0.6s 0.6s cubic-out fade-in-up both;
}

/* ---------- Rarity-Based Styling ---------- */

/* Normal Rarity - White-grayish */
.upgrade-card.rarity-normal {
  background-color: #1a2332;
  border-color: #adb5bd;
}

.upgrade-card.rarity-normal:hover {
  border-color: #dee2e6;
  background-color: #1f2937;
}

.upgrade-card.rarity-normal .card-title {
  color: #e9ecef;
}

.upgrade-card.rarity-normal .card-rarity {
  color: #adb5bd;
}

.upgrade-card.rarity-normal .card-header {
  border-bottom-color: #495057;
}

.upgrade-card.rarity-normal .card-description {
  color: #ced4da;
}

/* Common Rarity - Blue-ish */
.upgrade-card.rarity-common {
  background-color: #1a2332;
  border-color: #2196f3;
}

.upgrade-card.rarity-common:hover {
  border-color: #42a5f5;
  background-color: #1f2937;
}

.upgrade-card.rarity-common .card-title {
  color: #64b5f6;
}

.upgrade-card.rarity-common .card-rarity {
  color: #2196f3;
}

.upgrade-card.rarity-common .card-header {
  border-bottom-color: #1976d2;
}

.upgrade-card.rarity-common .card-description {
  color: #bbdefb;
}

/* Epic Rarity - Purple-ish */
.upgrade-card.rarity-epic {
  background-color: #1a2332;
  border-color: #9c27b0;
}

.upgrade-card.rarity-epic:hover {
  border-color: #ba68c8;
  background-color: #1f2937;
}

.upgrade-card.rarity-epic .card-title {
  color: #ce93d8;
}

.upgrade-card.rarity-epic .card-rarity {
  color: #ab47bc;
}

.upgrade-card.rarity-epic .card-header {
  border-bottom-color: #7b1fa2;
}

.upgrade-card.rarity-epic .card-description {
  color: #e1bee7;
}

/* Legendary Rarity - Gold-orange */
.upgrade-card.rarity-legendary {
  background-color: #1a2332;
  border-color: #ff9800;
}

.upgrade-card.rarity-legendary:hover {
  border-color: #ffb74d;
  background-color: #1f2937;
}

.upgrade-card.rarity-legendary .card-title {
  color: #ffcc02;
}

.upgrade-card.rarity-legendary .card-rarity {
  color: #ffa726;
}

.upgrade-card.rarity-legendary .card-header {
  border-bottom-color: #f57c00;
}

.upgrade-card.rarity-legendary .card-description {
  color: #ffe082;
}

/* ---------- Light Theme Overrides ---------- */
body.theme-light .upgrade-card {
  background-color: #ffffff;
  border-color: #cbd5e0;
}

body.theme-light .upgrade-card:hover {
  border-color: #3182ce;
  background-color: #f7fafc;
}

body.theme-light .upgrade-card:active,
body.theme-light .upgrade-card.selected {
  border-color: #2c5aa0;
  background-color: #3182ce1a;
}

body.theme-light .card-header {
  border-bottom-color: #e2e8f0;
}

body.theme-light .card-title {
  color: #3182ce;
}

body.theme-light .card-description {
  color: #2d3748;
}

/* ---------- Footer Elements ---------- */
.remaining-upgrades {
  font-size: 16dp;
  color: #ffcc02;
  font-weight: bold;
  margin-bottom: 12dp;
  text-align: center;
}

.remaining-upgrades.hidden {
  display: none;
}

/* Button Container */
.button-container {
  display: flex;
  flex-direction: row;
  gap: 12dp;
  justify-content: center;
  margin-top: 16dp;
}

.hide-button,
.reroll-button {
  padding: 12dp 24dp;
  border-radius: 8dp;
  color: white;
  font-size: 16dp;
  font-weight: bold;
  cursor: pointer;
  transition: background-color border-color 0.2s cubic-out;
  border: 2dp;
}

.hide-button {
  background-color: #6c757d;
  border-color: #5a6268;
}

.hide-button:hover {
  background-color: #5a6268;
  border-color: #545b62;
}

.hide-button:active {
  background-color: #545b62;
  border-color: #484f55;
}

.reroll-button {
  background-color: #17a2b8;
  border-color: #138496;
}

.reroll-button:hover {
  background-color: #138496;
  border-color: #117a8b;
}

.reroll-button:active {
  background-color: #117a8b;
  border-color: #0f6674;
}

.reroll-button.disabled {
  background-color: #495057;
  border-color: #343a40;
  cursor: not-allowed;
  opacity: 0.6;
}

.reroll-button.disabled:hover {
  background-color: #495057;
  border-color: #343a40;
}

/* ---------- Responsive Design ---------- */
@media (max-width: 1000dp) {
  .card-container {
    flex-direction: column;
    align-items: center;
    gap: 16dp;
    max-width: 320dp;
  }
  
  .upgrade-card {
    width: 100%;
    min-height: 240dp;
  }
}
