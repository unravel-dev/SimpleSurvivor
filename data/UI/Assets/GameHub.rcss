/* ---------- Modern Game HUD Styles - Hades Style ---------- */
/* Clean, sharp design with bottom-focused layout */

/* Override theme background for in-game HUD - no dimming */
body.theme-dark {
  background-color: transparent;
  margin: 0;
  padding: 0;
}

body {
  margin: 0;
  padding: 0;
}

/* ========== GAME TIMER - TOP CENTER ========== */
.timer-display {
  position: absolute;
  top: 20dp;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 230);
  border: 2dp rgba(255, 200, 0, 255);
  padding: 10dp 20dp;
  z-index: 2001;
  display: flex;
  align-items: center;
  gap: 12dp;
}


/* ========== BOSS HEALTH BARS - TOP OF SCREEN ========== */
.boss-health-container {
  position: absolute;
  top: 80dp;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12dp;
  z-index: 2000;
  flex-wrap: wrap;
  max-width: 90%;
}

.boss-health-container.hidden {
  display: none;
}

.boss-health-bar-wrapper {
  position: relative;
  min-width: 200dp;
  max-width: 350dp;
  flex: 1 1 auto;
  /* Allow wrapper to grow to accommodate longer names */
}

.boss-health-bar {
  width: 100%;
  height: 20dp;
  border: 2dp rgba(200, 50, 50, 255);
  background-color: rgba(20, 5, 5, 230);
  box-shadow: 0 2dp 6dp rgba(0, 0, 0, 200);
}

.boss-health-bar fill {
  decorator: linear-gradient(90deg, rgb(180, 20, 20), rgb(255, 50, 50));
  box-shadow: 0 0 6dp rgba(255, 50, 50, 150);
}

.boss-health-value {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-size: 12dp;
  font-weight: bold;
  font-effect: shadow(1dp 2dp rgba(0, 0, 0, 255));
  z-index: 10;
  pointer-events: none;
}

.boss-health-name {
  position: absolute;
  top: -18dp;
  left: 0;
  color: rgba(255, 200, 0, 255);
  font-size: 11dp;
  font-weight: bold;
  font-effect: shadow(1dp 2dp rgba(0, 0, 0, 255));
  white-space: nowrap;
  /* Allow name to extend beyond bar width if needed */
}

.boss-health-bar.low-health {
  background-color: rgba(40, 0, 0, 255);
  border-color: rgba(255, 0, 0, 255);
}

.boss-health-bar.low-health fill {
  background: rgb(255, 0, 0);
  filter: brightness(150%);
}

.timer-label {
  color: rgba(255, 200, 0, 255);
  font-size: 12dp;
  font-weight: bold;
  letter-spacing: 1dp;
}

.timer-value {
  color: white;
  font-size: 20dp;
  font-weight: bold;
  letter-spacing: 1dp;
}

/* ========== BOTTOM HUD CONTAINER ========== */
.bottom-hud {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2000;
}

/* ========== HEALTH BAR - ABOVE ABILITIES ========== */
.health-bar-container {
  position: relative;
  width: 450dp;
  margin-bottom: 12dp;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.health-progress {
  width: 100%;
  height: 24dp;
  border: 2dp rgba(255, 60, 60, 255);
  background-color: rgba(20, 5, 5, 230);
  box-shadow: 0 3dp 8dp rgba(0, 0, 0, 200);
}

.health-progress fill {
  decorator: linear-gradient(90deg, rgb(200, 30, 30), rgb(255, 60, 60));
  box-shadow: 0 0 8dp rgba(255, 60, 60, 150);
}

.health-value {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-size: 15dp;
  font-weight: bold;
  font-effect: shadow(2dp 4dp rgba(0, 0, 0, 255));
  z-index: 10;
  pointer-events: none;
}

/* Low Health Warning */
.health-progress.low-health {
  background-color: rgba(40, 0, 0, 255);
  border-color: rgba(255, 0, 0, 255);
  animation: pulse-red 0.5s infinite;
}

.health-progress.low-health fill {
  background: rgb(255, 0, 0);
  filter: brightness(150%);
}

/* ========== ABILITY BAR - CENTER BOTTOM ========== */
.ability-bar-container {
  position: relative;
  margin-bottom: 10dp;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8dp;
}

/* Upgrade Counter */
.upgrade-counter {
  display: flex;
  align-items: center;
  gap: 8dp;
  background-color: rgba(0, 0, 0, 200);
  border: 2dp rgba(255, 200, 0, 255);
  padding: 6dp 12dp;
  border-radius: 6dp;
}

.upgrade-counter.hidden {
  display: none;
}

.upgrade-counter-label {
  color: rgba(255, 200, 0, 255);
  font-size: 12dp;
  font-weight: bold;
  letter-spacing: 0.5dp;
}

.upgrade-counter-value {
  color: white;
  font-size: 16dp;
  font-weight: bold;
  min-width: 20dp;
  text-align: center;
}

.ability-bar {
  display: flex;
  gap: 10dp;
  padding: 0;
  background-color: transparent;
  border: 0;
  align-items: center;
}

.ability-slot {
  position: relative;
  width: 60dp;
  height: 60dp;
  background-color: transparent;
  border: 2dp rgba(80, 80, 90, 220);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

/* Dash Ability Slot - Larger */
.ability-slot-dash {
  width: 80dp;
  height: 80dp;
  border: 3dp rgba(100, 180, 255, 220);
  background-color: transparent;
  box-shadow: 0 0 10dp rgba(100, 180, 255, 100);
}

.ability-slot-dash .ability-icon {
  width: 100%;
  height: 100%;
  font-size: 32dp;
  background-color: transparent;
}

.ability-slot-dash .ability-cooldown {
  font-size: 32dp;
  line-height: 80dp;
}

.ability-slot-dash .ability-key {
  width: 50%;
  height: 20dp;
  padding: 0;
  font-size: 10dp;
}

.ability-slot-dash:hover {
  background-color: rgba(25, 45, 65, 100);
  border-color: rgba(120, 200, 255, 255);
  transform: translateY(-2dp);
}

.ability-slot-dash.on-cooldown {
  border-color: rgba(100, 180, 255, 150);
}

.ability-slot:hover {
  background-color: rgba(35, 35, 45, 100);
  border-color: rgba(140, 140, 160, 255);
  transform: translateY(-2dp);
}

.ability-slot.active {
  border-color: rgba(255, 200, 0, 255);
  border-width: 3dp;
  background-color: rgba(40, 35, 15, 100);
  box-shadow: 0 0 12dp rgba(255, 200, 0, 150);
}

.ability-slot.on-cooldown {
  border-color: rgba(255, 80, 80, 240);
}

.ability-icon {
  width: 100%;
  height: 100%;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24dp;
  color: rgba(180, 180, 190, 255);
  font-weight: bold;

}

.ability-icon.has-ability {
  background-color: transparent;
  color: white;
}

.ability-cooldown {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: transparent;
}

.ability-cooldown fill {
  background-color: rgba(0, 0, 0, 128);
}


.ability-key {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 16dp;
  background-color: rgba(0, 0, 0, 250);
  border: 1dp rgba(255, 255, 255, 220);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11dp;
  color: white;
  font-weight: bold;
  text-align: center;
}

/* Ability slot states for different ability types */
/* Note: Ability-specific styles (decorator, image, color) are now in CommonMenu.rcss */
/* Applied directly to .ability-icon.{abilityType} for reuse across slots and cards */

.ability-slot.empty .ability-icon {
  background-color: rgba(40, 40, 45, 180);
  border: 1dp rgba(80, 80, 90, 120);
  color: rgba(120, 120, 130, 200);
}

/* ========== EXPERIENCE BAR - FULL WIDTH BOTTOM ========== */
.xp-bar-bottom {
  position: relative;
  width: 100%;
  height: 18dp;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: stretch;
}

/* Level Display - Left corner */
.level-display {
  position: relative;
  background-color: rgba(0, 0, 0, 250);
  border-right: 2dp rgba(0, 200, 255, 255);
  padding: 0 16dp;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 50dp;
  box-shadow: 2dp 0 8dp rgba(0, 200, 255, 100);
}

.level-text {
  color: rgb(0, 200, 255);
  font-size: 14dp;
  font-weight: bold;
  letter-spacing: 1dp;
}

.xp-progress {
  flex: 1;
  height: 18dp;
  border: 0dp;
  background-color: rgba(15, 15, 20, 240);
  border-top: 1dp rgba(255, 255, 255, 60);
  margin: 0;
  padding: 0;
}

.xp-progress fill {
  decorator: linear-gradient(90deg, rgb(0, 180, 255), rgb(100, 220, 255));
  box-shadow: 0 0 10dp rgba(0, 200, 255, 180);
}