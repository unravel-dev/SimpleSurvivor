using System.Runtime.CompilerServices;
using Unravel.Core;

/// <summary>
/// Marker component that indicates an entity is stunned.
/// Added/removed by EffectsSystem when StunComponent is applied/expired.
/// Other systems (like Enemy AI) can check for this component to determine behavior.
/// </summary>
[ScriptSourceFile]
public class StunnedComponent : ScriptComponent
{
    // Pure marker component - no data needed
    // The presence of this component indicates the entity is stunned
}

