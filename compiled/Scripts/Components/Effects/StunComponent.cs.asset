using System.Runtime.CompilerServices;
using Unravel.Core;

/// <summary>
/// Stun effect that prevents enemies from moving or acting.
/// Inherits from EffectOverTime for duration tracking.
/// </summary>
[ScriptSourceFile]
public class StunComponent : EffectOverTime
{
    public override void OnStart()
    {
        // Stun effect initialization
        // Could add visual effects or disable enemy AI here
    }
  
    
    /// <summary>
    /// Get the effect name.
    /// </summary>
    /// <returns>Name of the effect.</returns>
    public override string GetEffectName()
    {
        return "Stun";
    }
    
    /// <summary>
    /// Get the effect color for UI visualization.
    /// </summary>
    /// <returns>Color as RGBA string.</returns>
    public override string GetEffectColor()
    {
        return "rgba(150, 150, 255, 200)"; // Light blue/purple for stun
    }
}

